[Unit]
Description=niri-tasks task panels
Documentation=https://github.com/pauldaywork/niri-tasks
# The task panels are layer-shell surfaces, so they need a Wayland session to attach
# to. graphical-session.target is what niri's session pulls in.
PartOf=graphical-session.target
After=graphical-session.target
# StartLimit* belong in [Unit]; systemd ignores them in [Service].
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=%h/.cargo/bin/niritasks daemon
# The panels are a readout: if they die, bring it back, but do not fight a crash
# loop that would spam the journal.
Restart=on-failure
RestartSec=3

# Environment=NIRITASKS_DEBUG=1

[Install]
WantedBy=graphical-session.target
