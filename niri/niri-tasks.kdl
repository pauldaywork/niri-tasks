// niri-tasks — workspace-scoped Taskwarrior.
//
// Included from ~/.config/niri/config.kdl as:
//     include "niri-tasks.kdl"
//
// niri merges binds blocks per-key rather than replacing them, so these live
// alongside whatever config.kdl defines. (Verified: the DMS stub at
// ~/.config/niri/dms/binds.kdl is an empty binds block included *after* the
// main one, and the main binds still work.)
//
// A missing include target is fatal to niri, so anything that ships this
// include must seed an empty stub when niri-tasks is not installed.

// Name workspace 1 on startup if it has no name. Naming matters more than it
// looks: the name is the tag the task shortcuts scope to, so an unnamed
// workspace has no tasks.
spawn-at-startup "wt" "workspace" "default"

// Blur behind the active-task overlay.
//
// The overlay draws a half-transparent background and nothing else; the blur is
// the other half of that effect and only a compositor can do it. Without this
// rule the overlay still works, it is just flat — the same trade the fuzzel
// picker theme documents for the "launcher" namespace.
//
// The namespace is set by the overlay itself (overlay.rs NAMESPACE), which is
// why it is not the crate default of "gtk4-layer-shell" — that would match any
// GTK layer-shell app on the system.
layer-rule {
    match namespace="^niri-tasks$"
    background-effect {
        blur true
        // Blur the wallpaper rather than whatever window happens to be under
        // the text, so the readout looks the same wherever it is shown.
        xray true
        noise 0.05
        saturation 1.4
    }
}

// Every bind below opens a popup, and every one of them holds the same lock
// while it does, so a second popup cannot open on top of the first.
//
// It is needed here more than anywhere else. The pickers are fuzzel, which
// refuses to run twice on its own — it flocks
// $XDG_RUNTIME_DIR/fuzzel-$WAYLAND_DISPLAY.lock and a second instance exits
// with "failed to acquire lock". The task box is not fuzzel: it is the GTK
// window in src/taskbox.rs, it has no lock, and fuzzel's lock does not know it
// exists. So `wt task add` opens a box on top of an open picker, and a picker
// opens on top of an open box, and nothing in either program can see the other.
//
// flock -n in the bind rather than a check inside wt, because the lock has to
// cover popups this program does not own: the application launcher and the
// wallpaper picker take the same lock from the other side, and a guard inside
// wt could not exclude them. It cannot race the way a "is one running?" test
// can, and the kernel drops the lock when the process ends however it ends, so
// there is nothing to clean up.
//
// The path is the contract, and the only thing shared with whatever else takes
// it — ubuntu-setup spells it the same way in config/niri/popup-guard.sh,
// fallback included. Change it here and it stops excluding anything there.
// Holding it is enough to be ignored: flock exits 1 without running the
// command, and niri does not care what a bind's process exited with.
binds {
    // Create a new workspace and name it.
    Mod+Alt+W hotkey-overlay-title="New Named Workspace" { spawn-sh "flock -n \"${XDG_RUNTIME_DIR:-/tmp}/niri-popup.lock\" wt workspace new"; }

    // Rename the current workspace — and with it, which tag its tasks carry.
    Mod+Shift+Alt+W hotkey-overlay-title="Rename Workspace" { spawn-sh "flock -n \"${XDG_RUNTIME_DIR:-/tmp}/niri-popup.lock\" wt workspace rename"; }

    // Pick a folder from ~/Projects, put it on its own named workspace, and
    // open a terminal and VS Code in it. The editor is skipped when `code` is
    // not on $PATH — it is a nicety here, not a requirement.
    //
    // This one keeps the lock a moment longer than the popup is up: the picker
    // closes, then the terminal and the editor are spawned, and only then does
    // wt exit. Under a second, and the alternative is dropping the lock while
    // the workspace is still being built.
    Mod+Alt+P hotkey-overlay-title="Open Project Workspace" { spawn-sh "flock -n \"${XDG_RUNTIME_DIR:-/tmp}/niri-popup.lock\" wt project open"; }

    // Taskwarrior, scoped to the current workspace's name as a tag.
    // Mod+Alt+T writes a new task; Mod+Alt+L lists this workspace's tasks and
    // offers edit / note / delete / complete / set-active on the one you pick.
    Mod+Alt+T hotkey-overlay-title="Add Task" { spawn-sh "flock -n \"${XDG_RUNTIME_DIR:-/tmp}/niri-popup.lock\" wt task add"; }
    Mod+Alt+L hotkey-overlay-title="Workspace Tasks: edit, note, complete" { spawn-sh "flock -n \"${XDG_RUNTIME_DIR:-/tmp}/niri-popup.lock\" wt task list"; }
}
