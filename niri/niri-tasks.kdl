// niri-tasks — workspace-scoped Taskwarrior.
//
// Included from ~/.config/niri/config.kdl as:
//     include "niri-tasks.kdl"
//
// niri merges binds blocks per-key rather than replacing them, so these live
// alongside whatever config.kdl defines. (Verified: the DMS stub at
// ~/.config/niri/dms/binds.kdl is an empty binds block included *after* the
// main one, and the main binds still work.)
//
// A missing include target is fatal to niri, so anything that ships this
// include must seed an empty stub when niri-tasks is not installed.

// Name workspace 1 on startup if it has no name. Naming matters more than it
// looks: the name is the tag the task shortcuts scope to, so an unnamed
// workspace has no tasks.
spawn-at-startup "niritasks" "workspace" "default"

// How the blur behind the task panel's cards looks. The same settings as the
// windows' background-effect, so a card reads like a terminal.
//
// Deliberately no `blur true`. A rule's blur covers the layer surface's whole
// rectangle, and the panel's surface is mostly empty space the cards slide
// through. Instead the panel asks for blur itself, over ext-background-effect,
// with a region the shape of its cards — niri turns blur on for exactly that,
// and takes the rest of the effect from here. The namespace is the panel's
// own (src/panel/surface.rs, NAMESPACE).
layer-rule {
    match namespace="^niri-tasks-panel$"
    background-effect {
        xray true
        noise 0.05
        saturation 1.4
    }
}

// One of the binds below is guarded against opening twice, and only one needs
// to be.
//
// The task panel and its project list are the daemon's own surfaces, one per
// monitor, so pressing their keys again shows the same one again rather than a
// second. The task box is the exception: it is the GTK window in
// src/taskbox.rs, a new one each time, so pressing Mod+Alt+T twice stacked two
// boxes. It spawns nothing that outlives it — Add & refine's refine goes
// through niri's spawn, not as its child — so a flock held across it is
// released when it closes.
binds {
    // A terminal in the focused workspace's project folder, ~/Projects/<name>
    // (or ~/Projects when there is no such folder). This replaces the plain
    // `spawn "ghostty"` a config.kdl without niri-tasks falls back on: includes
    // are positional, so this later bind of the same key wins.
    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "niritasks" "terminal"; }

    // The task panel's project list, in the middle of the screen: the
    // ~/Projects folders, then the GitHub repos not cloned yet. Picking one
    // (or typing a new name to make one) puts it on its own named workspace,
    // and opens a terminal on that workspace's herdr session
    // (`herdr --session <workspace>`) and VS Code in it. herdr reattaches the
    // session if it exists and creates it in the project folder if not. The
    // editor is skipped when `code` is not on $PATH — it is a nicety here,
    // not a requirement. Opening a project is the only way a workspace gets
    // a name, bar workspace 1's at startup. W for workspace.
    Mod+Alt+W hotkey-overlay-title="Open Project Workspace" { spawn "niritasks" "project" "open"; }

    // Taskwarrior, scoped to the current workspace's name as a tag.
    // Mod+Alt+T writes a new task; its Ctrl companion, Mod+Alt+Ctrl+T, shows the
    // task panel in the middle of the screen to pick one with the arrow keys; the
    // focused card's buttons act on it (start working, refine, edit, complete,
    // move, remove). With no tasks on the workspace, or a workspace with no
    // name, a notification says so instead.
    Mod+Alt+T hotkey-overlay-title="Add Task" { spawn-sh "flock -n \"${XDG_RUNTIME_DIR:-/tmp}/niritasks-taskbox.lock\" niritasks task add"; }
    // Mod+Alt+Shift+T is the same box with Add & refine as the default: once
    // added, the task opens in a "Refine: …" tab of the workspace's herdr
    // session. Same lock as Mod+Alt+T, so the two share one box at a time.
    Mod+Alt+Shift+T hotkey-overlay-title="Add Task and Refine" { spawn-sh "flock -n \"${XDG_RUNTIME_DIR:-/tmp}/niritasks-taskbox.lock\" niritasks task add --refine"; }
    Mod+Alt+Ctrl+T hotkey-overlay-title="Workspace Tasks: pick on the panel" { spawn "niritasks" "task" "panel"; }
}
